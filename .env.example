# Fitness Trainer
# Garmin-Daten. KI-Trainingsplan. Deine Uhr.

SECRET_KEY=einen-sehr-langen-zufaelligen-key-bitte-aendern

# Erster Admin (wird nur beim ersten Start angelegt)
ADMIN_USER=admin
ADMIN_PASSWORD=bitte-aendern-min-8-zeichen

# LLM (globaler Standard; pro User in den Einstellungen überschreibbar)
LLM_PROVIDER=opencode
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=8000

# Auto-Sync Intervall in Minuten (0 = aus)
SYNC_INTERVAL_MINUTES=360
SYNC_STALE_HOURS=24

# Port auf dem Host
PORT=8000
